{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLA Ebooks Creator",
  "version": "0.1.2",
  "identifier": "com.usuario.cla-ebooks",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:sidecar && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CLA Ebooks Creator",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src http://127.0.0.1:*; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/ebook-template": "ebook-template",
      "../resources/page-turn.mp3": "ebook-assets/page-turn.mp3",
      "binaries/ebook-generator-x86_64-pc-windows-msvc.exe": "ebook-generator.exe",
      "../node_modules/@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-400-normal.woff2": "ebook-fonts/ibm-plex-mono-latin-ext-400-normal.woff2",
      "../node_modules/@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-600-normal.woff2": "ebook-fonts/ibm-plex-mono-latin-ext-600-normal.woff2",
      "../node_modules/@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-700-normal.woff2": "ebook-fonts/ibm-plex-mono-latin-ext-700-normal.woff2"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
